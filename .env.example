# Copy this file to backend/.env and fill in your values.

# Get this from https://neon.tech (free) — used for both local dev and Vercel.
# On Vercel, add it in Project → Settings → Environment Variables instead.
DATABASE_URL=postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT secret — change this to a long random string before deploying
JWT_SECRET=replace-with-a-long-random-secret

# Port for local dev (Vercel ignores this)
PORT=4000

# Allowed CORS origin for local dev
FRONTEND_URL=http://localhost:5173
